+    #[test]
+    fn test_snapshot_read_hint_transitions_preserve_bytes() {
+        use std::io::{Read, Seek, Write};
+
+        let expected = vec![0x5a; host_page_size() * 4];
+        let mut source = TempFile::new().unwrap().into_file();
+        source.write_all(&expected).unwrap();
+        let regions = snapshot_file(
+            source,
+            [(GuestAddress(0), expected.len())].into_iter(),
+            false,
+        )
+        .unwrap();
+        let address = regions[0].as_ptr() as usize;
+        let is_random = || {
+            let maps = std::fs::read_to_string("/proc/self/smaps").unwrap();
+            let prefix = format!("{address:x}-");
+            let flags = maps
+                .lines()
+                .skip_while(|line| !line.starts_with(&prefix))
+                .find(|line| line.starts_with("VmFlags:"))
+                .expect("snapshot mapping has no kernel flags");
+            flags.split_whitespace().any(|flag| flag == "rr")
+        };
+        assert!(
+            is_random(),
+            "interactive snapshot restore must disable speculative read-ahead"
+        );
+
+        let memory = into_region_ext(regions);
+        let mut destination = TempFile::new().unwrap().into_file();
+        memory.dump(&mut destination, false).unwrap();
+        assert!(
+            !is_random(),
+            "full snapshot capture must restore normal read-ahead"
+        );
+        destination.rewind().unwrap();
+        let mut captured = Vec::new();
+        destination.read_to_end(&mut captured).unwrap();
+        assert_eq!(captured, expected);
